<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/green_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView android:id="@+id/tv_mission_name"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Mission Name"
                android:textStyle="bold" android:textSize="16sp" android:textColor="@color/white"/>

            <TextView android:id="@+id/tv_budget_mode"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔓 Flexible" android:textSize="12sp" android:textColor="#B2F5EA"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_mission"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:layout_marginBottom="6dp" android:max="100"
            android:progressTint="@color/green_primary"
            android:progressBackgroundTint="#33FFFFFF"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">

            <TextView android:id="@+id/tv_mission_pct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0%" android:textColor="#B2F5EA" android:textStyle="bold"
                android:textSize="13sp"/>

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <TextView android:id="@+id/tv_mission_target"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="R0 / R0" android:textSize="13sp" android:textColor="#B2F5EA"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_monthly_contrib"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="R0/mo recommended"
            android:textSize="12sp" android:textColor="#B2F5EA"
            android:layout_marginBottom="10dp"/>

        <Button android:id="@+id/btn_add_progress"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="+ Add Progress"
            android:textSize="12sp"
            android:backgroundTint="@color/green_light"
            android:textColor="@color/green_dark"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
